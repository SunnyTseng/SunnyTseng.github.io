@techreport{tseng_recordings_2026,
	title = {From recordings to ecology: {Turning} bird sounds into ecological insights},
	copyright = {IN COPYRIGHT},
	shorttitle = {From recordings to ecology},
	url = {https://unbc.arcabc.ca/dissertations-and-theses/30750},
	abstract = {,Passive acoustic monitoring is increasingly used to study bird populations across large spatiotemporal scales; however, converting large volumes of audio data into reliable ecological information remains a major challenge. Using three years of passive acoustic monitoring data collected in the John Prince Research Forest, British Columbia, Canada, I evaluate the performance of machine learning tools for avian acoustic identification, specifically BirdNET, and demonstrate their application to ecological questions across multiple ecological scales. First, I develop a workflow for setting species-specific confidence thresholds for BirdNET detections, comparing this approach with the use of a single universal threshold across species. I show that species-specific thresholds increase precision (the proportion of true positives among predicted detections) while also retaining a greater number of usable detections, thereby improving data quality without unnecessary data loss. Building on this workflow, I then demonstrate the feasibility of identifying individual Barred Owls (Strix varia) from passive acoustic monitoring data. Recordings collected under typical field conditions contain sufficient acoustic detail to extract individually distinctive vocal characteristics, highlighting the potential for passive acoustics to support individual-level analyses in nocturnal species. Third, I apply passive acoustic monitoring to quantify seasonal vocal activity patterns and habitat associations using a case-study species, the Olive-sided Flycatcher (Contopus cooperi). The resulting activity patterns and habitat relationships provide insight into species-specific phenology. Finally, I integrate passive acoustic monitoring data with LiDAR-derived habitat metrics to assess breeding bird richness. This study illustrates both the opportunities and the limitations of combining emerging monitoring technologies to investigate bird–habitat relationships at broader spatial scales. Together, this thesis demonstrates that passive acoustic monitoring coupled with automated identification tools, when carefully evaluated and applied, can move beyond simple presence– absence inference to address a wide range of ecological and management-relevant questions. The approaches developed here support more transparent, reproducible, and scalable use of passive acoustic monitoring for avian research and conservation.},
	language = {English},
	urldate = {2026-09-17},
	institution = {University of Northern British Columbia},
	author = {Tseng, Yi-Chun (Sunny)},
	month = apr,
	year = {2026},
	file = {Full Text PDF:C\:\\Users\\sunny\\Zotero\\storage\\TB42WIKG\\Tseng - 2026 - From recordings to ecology Turning bird sounds into ecological insights.pdf:application/pdf},
}

@article{tseng_automatic_2021,
	title = {Automatic bird sound detection: logistic regression based acoustic occupancy model},
	volume = {30},
	issn = {0952-4622},
	shorttitle = {Automatic bird sound detection},
	url = {https://doi.org/10.1080/09524622.2020.1730241},
	doi = {10.1080/09524622.2020.1730241},
	abstract = {Avian bioacoustics research was greatly assisted by the introduction of autonomous recording units, which not only allow remote monitoring but also make large-scale studies possible. However, manual inspection of acoustic recordings becomes more challenging with increasingly larger datasets. In this study, we developed a logistic model to predict the probability of bird presence in audio recordings using sound frequency percentiles. The acoustic recordings covered bird songs and calls in a wide range of environments (e.g. grassland, forest, urban areas) along with the presence of noise due to weather, traffic, insects, and human speech. Based on leave-one-out cross-validation, our final logistic model resulted in a 75\% overall accuracy and a 16\% false negative rate using the optimal cut-off of 0.35 (i.e. probability ≥ 0.35 indicates the presence of birds). Compared with a convolutional neural network model using the same dataset, the logistic model was about seven times faster in terms of the processing time, but achieved slightly lower overall accuracy. This bird sound detection model using sound frequency percentiles in a logistic model opens up promising approaches to aid in automatic, accurate, and efficient analyses of large audio datasets for monitoring wildlife communities.},
	number = {3},
	urldate = {2026-09-17},
	journal = {Bioacoustics},
	publisher = {Taylor \& Francis},
	author = {Tseng, Yi-Chin and Eskelson, Bianca N. I. and Martin, Kathy and LeMay, Valerie},
	month = may,
	year = {2021},
	keywords = {Autonomous recording units (ARUs), biodiversity monitoring, bird song recognition, convolutional neural networks, IEEE bird sound detection challenge},
	pages = {324--340},
}

@article{darras_worldwide_2025,
	title = {Worldwide {Soundscapes}: {A} {Synthesis} of {Passive} {Acoustic} {Monitoring} {Across} {Realms}},
	volume = {34},
	copyright = {© 2025 The Author(s). Global Ecology and Biogeography published by John Wiley \& Sons Ltd.},
	issn = {1466-8238},
	shorttitle = {Worldwide {Soundscapes}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/geb.70021},
	doi = {10.1111/geb.70021},
	abstract = {Aim The urgency for remote, reliable and scalable biodiversity monitoring amidst mounting human pressures on ecosystems has sparked worldwide interest in Passive Acoustic Monitoring (PAM), which can track life underwater and on land. However, we lack a unified methodology to report this sampling effort and a comprehensive overview of PAM coverage to gauge its potential as a global research and monitoring tool. To address this gap, we created the Worldwide Soundscapes project, a collaborative network and growing database comprising metadata from 416 datasets across all realms (terrestrial, marine, freshwater and subterranean). Location Worldwide, 12,343 sites, all ecosystem types. Time Period 1991 to present. Major Taxa Studied All soniferous taxa. Methods We synthesise sampling coverage across spatial, temporal and ecological scales using metadata describing sampling locations, deployment schedules, focal taxa and audio recording parameters. We explore global trends in biological, anthropogenic and geophysical sounds based on 168 selected recordings from 12 ecosystems across all realms. Results Terrestrial sampling is spatially denser (46 sites per million square kilometre—Mkm2) than aquatic sampling (0.3 and 1.8 sites/Mkm2 in oceans and fresh water) with only two subterranean datasets. Although diel and lunar cycles are well sampled across realms, only marine datasets (55\%) comprehensively sample all seasons. Across the 12 ecosystems selected for exploring global acoustic trends, biological sounds showed contrasting diel patterns across ecosystems, declined with distance from the Equator, and were negatively correlated with anthropogenic sounds. Main Conclusions PAM can inform macroecological studies as well as global conservation and phenology syntheses, but representation can be improved by expanding terrestrial taxonomic scope, sampling coverage in the high seas and subterranean ecosystems, and spatio-temporal replication in freshwater habitats. Overall, this worldwide PAM network holds promise to support cross-realm biodiversity research and monitoring efforts.},
	language = {en},
	number = {5},
	urldate = {2026-09-17},
	journal = {Global Ecology and Biogeography},
	author = {Darras, Kevin F. A. and Rountree, Rodney A. and Van Wilgenburg, Steven L. and Cord, Anna F. and Pitz, Frederik and Chen, Youfang and Dong, Lijun and Rocquencourt, Agnès and Desjonquères, Camille and Diaz, Patrick Mauritz and Lin, Tzu-Hao and Turco, Théophile and Emmerson, Louise and Bradfer-Lawrence, Tom and Gasc, Amandine and Marley, Sarah and Salton, Marcus and Schillé, Laura and Wensveen, Paul J. and Wu, Shih-Hung and Acero-Murcia, Adriana C. and Acevedo-Charry, Orlando and Adam, Matyáš and Aguzzi, Jacopo and Akoglu, Irmak and Amorim, M. Clara P. and Anders, Mina and André, Michel and Antonelli, Alexandre and Do Nascimento, Leandro Aparecido and Appel, Giulliana and Archer, Stephanie and Astaras, Christos and Atemasov, Andrey and Atkinson, Jamieson and Attia, Joël and Baltag, Emanuel and Barbaro, Luc and Basan, Fritjof and Batist, Carly and Baumgarten, Julio Ernesto and Bayle Sempere, Just T. and Bellisario, Kristen and David, Asaf Ben and Berger-Tal, Oded and Bertucci, Frédéric and Betts, Matthew G. and Bhalla, Iqbal S. and Bicudo, Thiago and Bolgan, Marta and Bombaci, Sara and Bota, Gerard and Boullhesen, Martin and Briers, Robert A. and Buchan, Susannah and Budka, Michal and Burchard, Katie and Buscaino, Giuseppa and Calvente, Alice and Campos-Cerqueira, Marconi and Gonçalves, Maria Isabel Carvalho and Ceraulo, Maria and Cerezo-Araujo, Maite and Cerwén, Gunnar and Chaskda, Adams A. and Chistopolova, Maria and Clark, Christopher W. and Cox, Kieran D. and Cretois, Benjamin and Czarnecki, Chapin and da Silva, Luis P. and da Silva, Wigna and De Clippele, Laurence H. and de la Haye, David and de Oliveira Tissiani, Ana Silvia and de Zwaan, Devin and Degano, M. Eugenia and Deichmann, Jessica and del Rio, Joaquin and Devenish, Christian and Díaz-Delgado, Ricardo and Diniz, Pedro and Oliveira-Júnior, Dorgival Diógenes and Dorigo, Thiago and Dröge, Saskia and Duarte, Marina and Duarte, Adam and Dunleavy, Kerry and Dziak, Robert and Elise, Simon and Enari, Hir